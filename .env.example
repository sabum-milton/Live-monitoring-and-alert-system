# CareWatch environment variables
# Copy to .env and fill in values. Never commit real credentials.

# Supabase project connection (required for the dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Optional remote notification provider webhook.
# Leave unset to keep notifications in-dashboard only.
CAREWATCH_NOTIFICATION_WEBHOOK_URL=
